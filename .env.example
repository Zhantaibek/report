NODE_ENV=development
# development — без записи в боевой QUIK Export; production — на сервере/Docker
APP_ENV=development
PORT=3001
API_BASE=/api
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
CURRENCY_UPDATE_INTERVAL_MS=120000
CURRENCY_API_URL=https://www.cbr-xml-daily.ru/daily_json.js

# App DB (PostgreSQL). For Docker use APP_DB_HOST=db
APP_DB_HOST=localhost
APP_DB_PORT=5432
APP_DB_NAME=quik_reports
APP_DB_USER=postgres
APP_DB_PASSWORD=

# External QUIK Export DB (optional, for seed)
POSTGRES_QUIK_HOST=
POSTGRES_QUIK_PORT=5432
POSTGRES_QUIK_DATABASE=
POSTGRES_QUIK_USER=
POSTGRES_QUIK_PASSWORD=

# Oracle (for USD report and instruments). JDBC: put classes12.zip + nls_charset12.zip in server/oracle-bridge/jdbc/ or set ORACLE_JDBC_JAR
ORACLE_DB_HOST=
ORACLE_DB_PORT=1521
ORACLE_DB_SID=
ORACLE_DB_NAME=
ORACLE_DB_USER=
ORACLE_DB_PASSWORD=
ORACLE_DB_OWNID=0
# ORACLE_JDBC_JAR=/app/server/oracle-bridge/jdbc/classes12.zip:/app/server/oracle-bridge/jdbc/nls_charset12.zip
